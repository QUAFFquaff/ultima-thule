---
import { withBase } from "../lib/paths";

const { day } = Astro.props;
---

<a href={withBase(`itinerary/${day.slug}/`)} class="glass block rounded-2xl p-4 transition hover:-translate-y-0.5 hover:border-cyan-200/45">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-sm font-semibold text-cyan-100/60">Day {day.day} · {day.date}</p>
      <h2 class="mt-2 text-xl font-black text-white">{day.icon} {day.title}</h2>
    </div>
    <span class="rounded-xl border border-cyan-200/20 bg-cyan-200/10 px-3 py-1 text-xs text-cyan-100">{day.region}</span>
  </div>
  <p class="mt-3 text-sm leading-6 text-cyan-50/70">{day.route}</p>
  <div class="mt-4 grid grid-cols-3 gap-2 text-xs">
    <span class="rounded-xl bg-white/10 p-2 text-cyan-50/80">{day.distance}</span>
    <span class="rounded-xl bg-white/10 p-2 text-cyan-50/80">{day.driveTime}</span>
    <span class="rounded-xl bg-white/10 p-2 text-cyan-50/80">{day.accommodation}</span>
  </div>
</a>
