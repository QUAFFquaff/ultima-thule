---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TripApp from "../components/TripApp.jsx";
import { sortDays } from "../lib/itinerary";

const entries = await getCollection("itinerary");
const days = sortDays(entries);
---

<BaseLayout>
  <TripApp client:load days={days} baseUrl={import.meta.env.BASE_URL} />
</BaseLayout>
