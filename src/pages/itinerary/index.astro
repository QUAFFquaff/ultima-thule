---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DayCard from "../../components/DayCard.astro";
import { sortDays } from "../../lib/itinerary";

const days = sortDays(await getCollection("itinerary"));
---

<BaseLayout title="全部行程">
  <section class="space-y-5">
    <div class="glass rounded-2xl p-5">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-100/60">all days</p>
      <h1 class="aurora-text mt-2 text-4xl font-black">全部行程</h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-cyan-50/72">13 天路线全部来自 Astro content collection。后续修改行程，只需要改对应 `src/content/itinerary/dayXX.md`。</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {days.map((day) => <DayCard day={day} />)}
    </div>
  </section>
</BaseLayout>
